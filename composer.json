{
    "name": "elavora/api-skeleton",
    "description": "Projeto base para APIs construidas com o framework Elavora.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "elavora/api-framework": "dev-main as 1.0.x-dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "test": "@php vendor/bin/phpunit -c phpunit.xml",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@lint",
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "api-framework",
        "type": "git",
        "url": "https://github.com/Elavora/api-framework.git"
    }]
}
